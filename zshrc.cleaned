# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git)

typeset -U path
path=("$HOME/.local/bin" "$HOME/.opencode/bin" $path)
export PATH

[[ -r "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

alias zshconfig='${EDITOR:-nano} "$HOME/.zshrc"'
alias session-apply='"$HOME/.local/bin/campus-session"'
